# 复制为 .env.local 并填入真实值

# ============ LLM 配置 ============
# 可选: deepseek / zhipu / qwen / openai（出海时改 openai 即可）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxx
# ZHIPU_API_KEY=
# QWEN_API_KEY=
# OPENAI_API_KEY=

# ============ Supabase 配置 ============
# Project URL 和 anon key: 项目设置 -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx

# Service Role Key（服务端专用，绝不能泄露到前端）
# 位置: 项目设置 -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# ============ Supabase Auth 配置提醒 ============
# 1. 到 Authentication -> Providers 启用 Email 登录
# 2. 建议关闭 "Confirm email"（个人工具免邮箱验证）
#    或保留开启，注册后查收确认邮件