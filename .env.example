# 复制为 .env.local 并填入真实值

# ============ LLM 配置 ============
# 可选: deepseek / zhipu / qwen / agnes / openai（出海时改 openai 即可）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxx
# ZHIPU_API_KEY=
# QWEN_API_KEY=
# AGNES_API_KEY=
# OPENAI_API_KEY=

# ============ 联网搜索增强（可选，强烈推荐）============
# 到 https://tavily.com 注册，每月免费 1000 次调用
# 留空则退化为纯模型知识生成简报
TAVILY_API_KEY=tvly-xxx
# 每次分析抓取的搜索结果条数（1-10）
SEARCH_MAX_RESULTS=5

# ============ Supabase 配置 ============
# Project URL 和 anon key: 项目设置 -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx 或 eyJxxx

# Service Role Key（服务端专用，绝不能泄露到前端）
# 位置: 项目设置 -> API -> service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx 或 eyJxxx

# ============ Supabase Auth 配置提醒 ============
# 1. 到 Authentication -> Providers 启用 Email 登录
# 2. 建议关闭 "Confirm email"（个人工具免邮箱验证）